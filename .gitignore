# Dependencies
node_modules/

# Build output
dist/
build/
dist-npm/

# API 前端构建产物落盘（apps/api/frontend/dist 由 prod/deploy.sh 同步，
# 历史手工拷贝的 stale 副本以 dist.stale-* 隔离；整个目录不入库）
apps/api/frontend/

# Environment files (secrets — NEVER commit real values)
.env
.env.local
.env.*.local
.env.production
.env.pm2

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# PM2
.pm2/

# GitHub workflows should be tracked
# .github/ is ignored except workflows
.github/*
!.github/workflows/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

# Harness traces and runtime state
**/.harness/*
# 但治理配置入库（声明式文档门禁，CI 消费）
!**/.harness/config.yml
# checkpoint 定义同属治理配置（2026-08-09 起；
# 运行时状态 trace/logs/knowledge/*-state.json/resolutions.json 照旧排除）
!**/.harness/checkpoints.yml

# Test results (screenshots, videos)
test-results/

# Spec source (ignored; docs/adr/ 豁免——决策记录是公共面永久导航件，须常规追踪，2026-08-21)
docs/*
!docs/adr/
# docs/visual-reports/ 豁免——#390 决议：截图 diff 报告入 git 作改版验收凭据（#391）
!docs/visual-reports/
# docs/specs/ui/style-guide.md 豁免——样式规范是唯一权威来源，须入 git 评审/回溯（批次 I-1 治理人闸当场过，2026-09-16）；其余 spec 源文件维持忽略
!docs/specs/
docs/specs/*
!docs/specs/ui/
docs/specs/ui/*
!docs/specs/ui/style-guide.md

# Scratch workspace (ignored)
.scratch/

# PM2 配置（可能包含敏感信息）
ecosystem.config.cjs
.env.pm2
start-pm2.sh
start-pm2.sh
packages/studio-prisma/prisma/test.db
packages/studio-prisma/prisma/test.db
e2e/.auth.json

# Session data (private)
.analyst/
.daemon/
*.db
# .studio/ 整体为会话私有，但 CONTEXT.md（#152 起模块上下文唯一正本）与 legacy-sdd/ 遗产归档（#155 起，原样迁入只读）入库
.studio/*
!.studio/CONTEXT.md
!.studio/legacy-sdd/

# Claude Code (development only)
CLAUDE.md
.claude/

# Runner worktree artifacts (regenerated per worktree at runtime; committing them
# breaks per-worktree regeneration, and worktrees inherit tracked files).
# 两条写方随 #562 删除，保留规则只为兜住历史 worktree 里的残留产物。
CACHE_PREFIX.md
.prompt.md

# Design docs (ignored)
DESIGN_REFACTOR.md

# Pipeline-generated SDD docs in wrong location (canonical: docs/sdd/)
apps/api/docs/

# Development artifacts
1
.gitignore.bak
.env.beta
*.tgz

# Unified config (contains API keys)
config.env

# Vitest compile cache
node-compile-cache/

# TypeScript build cache
*.tsbuildinfo

# Agent CLI local runtime state (credentials/oauth, never commit)
.codex/
.kimi-code/

# 本地 playwright 覆盖配置（勿提交）
*.local.config.ts
.env.test
