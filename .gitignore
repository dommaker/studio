# Dependencies
node_modules/

# Build output
dist/
build/

# API 前端构建产物落盘（apps/api/frontend/dist 由 prod/deploy.sh 同步，
# 历史手工拷贝的 stale 副本以 dist.stale-* 隔离；整个目录不入库）
apps/api/frontend/

# Environment files (secrets — NEVER commit real values)
.env
.env.local
.env.*.local
.env.production
.env.pm2

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# PM2
.pm2/

# GitHub workflows should be tracked
# .github/ is ignored except workflows
.github/*
!.github/workflows/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

# Harness traces and runtime state
**/.harness/*
# 但治理配置入库（声明式文档门禁，CI 消费）
!**/.harness/config.yml
# 自定义约束与 checkpoint 定义同属治理配置（2026-08-09 起；
# 运行时状态 trace/logs/knowledge/*-state.json/resolutions.json 照旧排除）
!**/.harness/custom-constraints.yml
!**/.harness/checkpoints.yml

# Test results (screenshots, videos)
test-results/

# Spec source (ignored)
docs/

# Scratch workspace (ignored)
.scratch/

# PM2 配置（可能包含敏感信息）
ecosystem.config.cjs
.env.pm2
start-pm2.sh
start-pm2.sh
packages/studio-prisma/prisma/test.db
packages/studio-prisma/prisma/test.db
e2e/.auth.json

# Session data (private)
.analyst/
.daemon/
*.db
# .studio/ 整体为会话私有，但 CONTEXT.md（#152 起模块上下文唯一正本）与 legacy-sdd/ 遗产归档（#155 起，原样迁入只读）入库
.studio/*
!.studio/CONTEXT.md
!.studio/legacy-sdd/

# Claude Code (development only)
CLAUDE.md
.claude/

# Runner worktree artifacts (regenerated per worktree at runtime;
# committing them breaks per-worktree regeneration — runner-execution only
# writes CACHE_PREFIX.md when absent, and worktrees inherit tracked files)
CACHE_PREFIX.md
.prompt.md

# Design docs (ignored)
DESIGN_REFACTOR.md

# Pipeline-generated SDD docs in wrong location (canonical: docs/sdd/)
apps/api/docs/

# Development artifacts
1
.gitignore.bak
.env.beta
*.tgz

# Unified config (contains API keys)
config.env

# Vitest compile cache
node-compile-cache/

# TypeScript build cache
*.tsbuildinfo
