{
  "name": "@dommaker/studio",
  "version": "0.2.0",
  "description": "Agent Studio - Multi-Agent Collaboration Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dommaker/studio.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "studio": "./bin/studio"
  },
  "files": [
    "bin/studio",
    "dist-npm"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:npm": "node scripts/build-npm.mjs",
    "prepack": "node scripts/build-npm.mjs",
    "dev": "pnpm -r dev",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "pnpm lint:cycles && pnpm -r lint",
    "lint:cycles": "node scripts/check-module-cycles.mjs",
    "perf:bench": "node node_modules/tsx/dist/cli.mjs scripts/perf/bench.ts",
    "perf:gate": "node node_modules/tsx/dist/cli.mjs scripts/perf/gate.ts",
    "perf:scale": "node node_modules/tsx/dist/cli.mjs scripts/perf/scale.ts",
    "perf:browser": "node node_modules/tsx/dist/cli.mjs scripts/perf/browser.ts",
    "perf:bundle": "node node_modules/tsx/dist/cli.mjs scripts/perf/bundle-budget.ts",
    "perf:lcp": "node node_modules/tsx/dist/cli.mjs scripts/perf/lcp.ts",
    "=== 开发环境 ===": "",
    "dev:start": "./scripts/dev/start.sh",
    "dev:stop": "./scripts/dev/stop.sh",
    "dev:status": "./scripts/dev/status.sh",
    "dev:logs": "./scripts/dev/logs.sh",
    "=== 生产环境 ===": "生产部署/启停脚本在 /root/projects/studio-config（scripts/prod/* + scripts/auto-deploy.sh），流程见该仓 SHIP.md；本仓只保留通用 start",
    "start": "npx tsx apps/api/src/index.ts",
    "=== 数据库 ===": "(Spec 4 Phase 4 — DB已移除, 全部使用 FileStore)",
    "=== 单独启动 ===": "",
    "dev:api": "pnpm --filter @dommaker/studio-api dev",
    "dev:web": "pnpm --filter @dommaker/studio-web dev",
    "build:api": "pnpm --filter @dommaker/studio-api build",
    "build:web": "pnpm --filter @dommaker/studio-web build",
    "test:api": "pnpm --filter @dommaker/studio-api test",
    "=== 工具脚本 ===": "",
    "tools:health": "./scripts/tools/health-check.sh",
    "tools:status": "./scripts/tools/status.sh",
    "typecheck": "node bin/tsc-gate.js --check",
    "gen:agents-md": "node scripts/gen-agents-md.mjs",
    "gen:required-dirs": "node scripts/gen-required-dirs.mjs",
    "agents-md:sync": "npx harness sync-docs --agents && node scripts/gen-agents-md.mjs",
    "postinstall": "node -e \"const fs=require('fs'),{execSync}=require('child_process');if(fs.existsSync('scripts/harness-sync.js'))execSync('node scripts/harness-sync.js',{stdio:'inherit'})\"",
    "prepare": "node scripts/harness-sync.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright": "^1.62.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "catalog:",
    "web-vitals": "^6.2.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@dommaker/harness": "^4.0.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
