{
  "name": "@dommaker/studio-shared",
  "version": "0.1.0",
  "description": "Studio shared utilities and CLI framework",
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./src/web.ts"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./src/node.ts"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./src/cli/index.ts"
    },
    "./studio-dir": {
      "types": "./dist/config/studio-dir.d.ts",
      "default": "./src/config/studio-dir.ts"
    },
    "./constants": {
      "types": "./dist/constants/levels.d.ts",
      "default": "./src/constants/levels.ts"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./src/harness/index.ts"
    },
    "./harness/hooks": {
      "types": "./dist/harness/hooks/index.d.ts",
      "default": "./src/harness/hooks/index.ts"
    },
    "./harness/runtime/bootstrap": {
      "types": "./dist/harness/runtime/bootstrap.d.ts",
      "default": "./src/harness/runtime/bootstrap.ts"
    },
    "./stats/*": {
      "types": "./dist/stats/*.d.ts",
      "default": "./src/stats/*"
    }
  },
  "scripts": {
    "build": "tsc && npx tsx ../../scripts/tools/hooks-closure-check.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dommaker/harness": "^1.1.1",
    "yaml": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "studio",
    "cli",
    "shared"
  ],
  "license": "MIT"
}
