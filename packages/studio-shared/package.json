{
  "name": "@dommaker/studio-shared",
  "version": "0.1.0",
  "description": "跨 apps/packages 共享层：FileStore、eventBus、provider 注册表、共享类型与工具",
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./src/web.ts"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./src/node.ts"
    },
    "./studio-dir": {
      "types": "./dist/config/studio-dir.d.ts",
      "default": "./src/config/studio-dir.ts"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "default": "./src/migrations/index.ts"
    },
    "./read-metrics": {
      "types": "./dist/read-metrics.d.ts",
      "default": "./src/read-metrics.ts"
    },
    "./constants": {
      "types": "./dist/constants/levels.d.ts",
      "default": "./src/constants/levels.ts"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./src/harness/index.ts"
    },
    "./harness/runtime/bootstrap": {
      "types": "./dist/harness/runtime/bootstrap.d.ts",
      "default": "./src/harness/runtime/bootstrap.ts"
    },
    "./stats/*": {
      "types": "./dist/stats/*.d.ts",
      "default": "./src/stats/*"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dommaker/harness": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.2"
  },
  "keywords": [
    "studio",
    "cli",
    "shared"
  ],
  "license": "MIT"
}
