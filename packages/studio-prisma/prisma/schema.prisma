generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite 不支持数组类型，String[] 和 Float[] 字段
// 改为 String（JSON 序列化存储），应用层做 parse/stringify

model Agent {
  id           String         @id @default(cuid())
  name         String
  version      String
  description  String?
  category     String
  icon         String?
  tags String @default("[]")
  inputSchema  String
  outputSchema String
  configSchema String
  endpoint     String?
  timeout      Int            @default(1800)
  retryPolicy  String?
  rateLimit    String?
  metadata     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@unique([id, version])
  @@index([category])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  key         String    @unique
  permissions String?
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  roleId       String?
  companyId    String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  action       String
  resource     String
  resourceId   String?
  details      String?
  changes      String?
  status       String   @default("success")
  errorCode    String?
  errorMessage String?
  sessionId    String?
  requestId    String?
  
  User         User?    @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([action])
  @@index([companyId])
  @@index([createdAt])
  @@index([resourceId])
  @@index([resource])
  @@index([roleId])
  @@index([status])
  @@index([userId])
}

model Capability {
  id                 String             @id @default(cuid())
  name               String
  type               String
  cost               Int                @default(1000)
  description        String?
  metadata           String?
  status             String             @default("active")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  autoTestStatus     String             @default("pending")
  ownerId            String?
  ownershipType      String             @default("private")
  price              Int                @default(0)
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  reviewStatus       String             @default("pending")
  usageCount         Int                @default(0)
  userApprovalStatus String             @default("pending")
  CapabilityReview   CapabilityReview[]

  @@unique([name, type])
  @@index([ownershipType])
  @@index([rating])
  @@index([type])
}

model CapabilityReview {
  id           String     @id @default(cuid())
  capabilityId String
  roleId       String
  score        Int
  comment      String?
  createdAt    DateTime   @default(now())
  Capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, roleId])
  @@index([capabilityId])
}

model Company {
  id           String         @id @default(cuid())
  name         String
  size         String         @default("small")
  adminRoleIds String @default("[]")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Role         Role[]
  OKR          OKR[]
  Documents    Document[]
  projects     Project[]
  Goal         Goal[]
  Skill        Skill[]
}

model OKR {
  id         String      @id @default(cuid())
  companyId  String
  title      String
  objectives String
  keyResults String
  quarter    String
  status     String      @default("active")
  progress   Float       @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  Execution  Execution[]
  Company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Project    Project[]

  @@unique([companyId, quarter])
  @@index([companyId])
  @@index([status])
  @@index([quarter])
  @@map("okr")
}

// KRHistory — KR 进度历史快照 (B8 OKR 驱动闭环)
model KRHistory {
  id        String   @id @default(cuid())
  krId      String
  okrId     String
  value     Float
  status    String   // ok | no_data | stale
  timestamp DateTime @default(now())

  @@index([okrId, krId])
  @@index([timestamp])
  @@map("kr_history")
}


model Countersign {
  id             String         @id @default(cuid())
  documentId     String
  config         String
  signers        String
  result         String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  SignedDocument SignedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentFlow {
  id             String         @id @default(cuid())
  documentId     String
  status         String         @default("running")
  steps          String
  currentStep    Int            @default(0)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  SignedDocument SignedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([status])
}

model Execution {
  id             String    @id @default(cuid())
  workflowId     String?
  status         String    @default("pending")
  startTime      DateTime?
  endTime        DateTime?
  parameters     String?
  nodeExecutions String?
  error          String?
  roleId         String?
  okrId          String?
  createdAt      DateTime  @default(now())
  OKR            OKR?      @relation(fields: [okrId], references: [id])
  Role           Role?     @relation(fields: [roleId], references: [id])
  Task           Task?

  @@index([createdAt])
  @@index([status])
  @@index([workflowId])
  @@index([roleId])
  @@index([okrId])
}

// ─── Goal 驱动架构 ───

model Goal {
  id            String      @id @default(cuid())
  title         String
  description   String
  status        String      @default("draft")     // draft | planning | executing | succeeded | failed | blocked
  priority      String      @default("normal")    // low/normal/high/critical
  constraints   String?                               // 人定义的约束条件
  context       String?                               // 上下文信息（会议、项目等）
  companyId     String
  createdBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  completedAt   DateTime?
  GoalPlan      GoalPlan[]
  GoalExecution GoalExecution[]
  Company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model GoalPlan {
  id          String        @id @default(cuid())
  goalId      String
  status      String        @default("draft")     // draft | approved | executing | completed
  steps       String                                  // GoalStep[]: LLM 生成的执行计划
  reasoning   String?                               // LLM 的推理过程
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Goal        Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  GoalExecution GoalExecution[]

  @@index([goalId])
  @@index([status])
}

model GoalExecution {
  id          String     @id @default(cuid())
  goalId      String
  planId      String?    // G34: optional — GoalPlan stage eliminated for direct acGroup→Execution
  stepIndex   Int                                    // 对应 GoalPlan.steps 中的索引
  status      String     @default("pending")         // pending | running | succeeded | failed
  agentType   String?                                // 执行此步骤的 agent 类型
  input       String?                                  // 步骤输入
  output      String?                                  // 步骤输出
  error       String?
  failureType String?                                  // 失败分类: retryable|not-retryable|infrastructure|unknown
  retryCount  Int        @default(0)                    // 失败重试次数
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  Goal        Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  GoalPlan    GoalPlan?  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([planId])
  @@index([status])
  @@index([failureType])
}

// ─── LLM 配置体系 ───

model LLMConfig {
  id          String   @id @default(cuid())
  scope       String   // orchestrator | agent_codex | agent_claude | agent_opencode | agent_default | studio
  provider    String   // anthropic | openai | tencent | deepseek | custom
  baseUrl     String?
  model       String
  options     String?    // temperature, maxTokens, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, provider])
  @@index([scope])
  @@index([isActive])
}

model IssueReport {
  id                   String    @id @default(cuid())
  title                String
  description          String
  type                 String
  severity             String
  documentId           String?
  taskId               String?
  workflowId           String?
  responsibilityChain  String
  accountabilityResult String?
  totalPenalty         Float     @default(0)
  status               String    @default("reported")
  resolvedAt           DateTime?
  reportedBy           String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([documentId])
  @@index([severity])
  @@index([taskId])
  @@index([type])
}

model Review {
  id            String   @id @default(cuid())
  reviewerId    String
  reviewerType  String
  targetId      String
  targetType    String
  featureId     String?
  taskId        String?
  ticketId      String?
  dimensions    String
  overallScore  Float
  comment       String?
  tags String @default("[]")
  createdAt     DateTime @default(now())
  rewardGranted Boolean  @default(false)
  couponId      String?

  @@index([createdAt])
  @@index([reviewerId])
  @@index([targetId])
  @@index([targetType])
}

model Role {
  id                 String               @id @default(cuid())
  name               String
  type               String
  avatar             String?
  personality        String?
  level              Int                  @default(1)
  capabilityLimit    Int                  @default(10)
  salary             Int                  @default(5000)
  balance            Int                  @default(0)
  tasksCompleted     Int                  @default(0)
  qualityScore       Float                @default(0)
  satisfactionRate   Float                @default(0)
  status             String               @default("active")
  companyId          String
  
  // 🆕 SEC-001: 创建者追踪（用于权限控制）
  creatorId          String?
  
  isProjectLead      Boolean              @default(false)
  workflows          String?
  memory             String?                 // RoleMemory: 角色记忆（经验/决策/反馈/学习）
  joinedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Execution          Execution[]
  Company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ClaimedTasks       Task[]
  CreatedDocuments   Document[]           @relation("DocumentCreator")
  Creator            User?                @relation("CreatedRoles", fields: [creatorId], references: [id])
  Skills             Skill[]
  MemoryEntries      RoleMemoryEntry[]

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([isProjectLead])
}

model SignedDocument {
  id             String         @id @default(cuid())
  type           String
  status         String         @default("draft")
  title          String
  body           String
  attachments    String?
  signers        String
  reviewResult   String?
  parentDocument String?
  taskId         String?
  workflowId     String?
  roleIds String @default("[]")
  createdBy      String
  updatedBy      String
  version        Int            @default(1)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Countersign    Countersign[]
  DocumentFlow   DocumentFlow[]

  @@index([createdAt])
  @@index([status])
  @@index([taskId])
  @@index([type])
  @@index([workflowId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   // null for OAuth users
  name         String?
  avatar       String?
  role         String    @default("Guest") // Guest, User, Admin
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // 关联
  sessions       Session[]
  refreshTokens  RefreshToken[]
  oauthAccounts  OAuthAccount[]
  auditLogs      AuditLog[] @relation("UserAuditLogs")
  createdRoles   Role[]    @relation("CreatedRoles")
}

model Session {
  id        String    @id @default(cuid())
  userId    String?
  token     String    @unique // JWT
  guestId   String?   // Guest Session 的临时 ID
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  
  User      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OAuthAccount {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  providerAccountId String
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  profile          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id               String   @id @default(cuid())
  age              Int
  gender           String
  occupation       String
  location         String?
  interests String @default("[]")
  techLevel        String
  spendingHabits   String
  activityLevel    String
  feedbackStyle    String
  priceSensitivity Float    @default(0.5)
  isSimulated      Boolean  @default(true)
  balance          Int      @default(0)
  totalSpent       Int      @default(0)
  memberLevel      String   @default("free")
  registeredAt     DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  reviewCount      Int      @default(0)
  averageRating    Float    @default(0)
  points           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isSimulated])
  @@index([memberLevel])
}

model SpecReview {
  id                 String               @id @default(cuid())
  workflowId         String?
  title              String
  description        String?
  changes            String
  changeType         String
  impact             String
  status             String               @default("pending")
  approvals          String
  requestedBy        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  reviewedAt         DateTime?
  reviewedBy         String?
  comment            String?
  SpecBypass         SpecBypass?
  SpecReviewApproval SpecReviewApproval[]
  SpecVersions       SpecVersion[]

  @@index([workflowId])
  @@index([status])
  @@index([changeType])
  @@index([createdAt])
}

model SpecReviewApproval {
  id           String     @id @default(cuid())
  reviewId     String
  role         String
  reviewerId   String
  reviewerName String
  approved     Boolean
  comment      String?
  createdAt    DateTime   @default(now())
  SpecReview   SpecReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, role])
  @@index([reviewId])
  @@index([reviewerId])
}

model SpecBypass {
  id            String      @id @default(cuid())
  specReviewId  String?     @unique
  reason        String
  urgency       String
  requestedBy   String
  requestedName String?
  approvedBy    String?
  approvedName  String?
  status        String      @default("pending")
  reviewedAt    DateTime?
  completedAt   DateTime?
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  specReview    SpecReview? @relation(fields: [specReviewId], references: [id])

  @@index([status])
  @@index([requestedBy])
  @@index([approvedBy])
  @@index([createdAt])
}

model SpecVersion {
  id          String     @id @default(cuid())
  reviewId    String
  version     Int
  content     String
  diff        String?
  changeType  String
  changeDesc  String?
  createdBy   String
  createdName String?
  createdAt   DateTime   @default(now())
  review      SpecReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, version])
  @@index([reviewId])
  @@index([version])
  @@index([createdBy])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Project {
  id             String    @id @default(cuid())
  pmoNumber      String    @unique
  title          String
  description    String?
  requirement    String?
  companyId      String
  okrId          String?
  status         String    @default("pending")
  priority       String    @default("medium")
  gitBranch      String?
  gitRepo        String?
  workspaceRepoId String?
  workspaceRepo  WorkspaceRepo? @relation(fields: [workspaceRepoId], references: [id])
  progress       Int       @default(0)
  specFilePath   String?   // 🆕 FL-022: Spec 文档路径
  specVersion    Int?      @default(1)  // 🆕 FL-022: Spec 版本号
  requirementsDocId String?  // A4: bidirectional link to RequirementsDoc
  dependsOnPmoId  String?      // O3e: PMO number this project depends on
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Tasks          Task[]
  Documents      Document[] // 🆕 知识库文档关联
  Company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  okr            OKR?      @relation(fields: [okrId], references: [id])

  @@unique([companyId, pmoNumber])
  @@index([companyId])
  @@index([status])
  @@index([pmoNumber])
  @@map("project")
}

// 🆕 公司知识库文档
model Document {
  id              String    @id @default(cuid())
  projectId       String    // 关联 PMO 项目
  companyId       String    // 公司 ID
  
  // 文档属性
  type            String    // requirement/design/spec/execution/meeting/archive
  title           String
  content         String?   // 文档内容（Markdown）
  filePath        String?   // 文件路径（可选）
  
  // 元数据
  version         Int       @default(1)
  status          String    @default("active")  // active/archived/deleted
  tags String @default("[]")  // 标签
  
  // 作者信息
  createdBy       String?   // 创建者角色 ID
  updatedBy       String?   // 最后更新者
  
  // 时间
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  
  // 关联
  Project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  CreatedBy       Role?     @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  
  @@unique([projectId, type, version])
  @@index([projectId])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([companyId, status, type])
  @@map("document")
}

model Task {
  id                 String     @id @default(cuid())
  projectId          String
  name               String
  description        String?
  assignee           String
  priority           String     @default("P2")
  status             String     @default("pending")
  claimedBy          String?
  claimedAt          DateTime?
  dependsOn String @default("[]")
  acceptanceCriteria String @default("[]")
  executionId        String?    @unique
  estimatedHours     Int?
  startedAt          DateTime?
  completedAt        DateTime?
  testEvidence       String?    // 🆕 AS-006: 测试证据路径
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  ClaimedBy          Role?      @relation(fields: [claimedBy], references: [id])
  Execution          Execution? @relation(fields: [executionId], references: [id])
  Project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assignee])
  @@index([priority])
  @@index([status])
  @@index([projectId])
  @@index([claimedBy])
  @@index([projectId, status])
}

model Skill {
  id           String   @id @default(cuid())
  companyId    String
  roleId       String?
  name         String
  source       String   @default("extraction") // extraction, manual, proposal
  status       String   @default("draft") // draft, testing, published, under_review, deprecated
  version      Int      @default(1)
  category     String?
  description  String?
  prompt       String?   // 注入 Agent 的 prompt 内容
  trigger      String?   // goal_start | goal_continue | review | ...
  agentTypes   String?   // JSON array: ["executor", "reviewer"]
  tier         String?   // fast | standard | premium
  tools        String?   // JSON array: ["tool-name-1", "tool-name-2"]
  required     String?   // JSON array: ["skill-id-1"] — 依赖的其他 skill
  autoLoad     Boolean   @default(false) // 条件匹配时自动加载
  isBuiltin    Boolean   @default(false)
  usageCount   Int      @default(0)
  successRate  Float    @default(0)
  avgDuration  Float    @default(0)
  metadata     String?
  extractedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  proposals    SkillProposal[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([roleId])
  @@index([category])
  @@index([status])
}

model SkillProposal {
  id         String   @id @default(cuid())
  skillId    String
  status     String   @default("pending") // pending, approved, rejected
  proposedBy String
  summary    String?
  proposedAt DateTime @default(now())
  reviewedAt DateTime?

  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
  @@index([status])
  @@index([proposedBy])
}

model Environment {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  dockerImage      String   @default("node:20-slim")
  dependencies     String @default("[]")
  envVars          String     @default("{}")
  networkMode      String   @default("bridge")
  mounts           String     @default("[]")
  resourceLimits   String     @default("{}")
  status           String   @default("active") // active, deprecated
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agentConfigs     AgentConfig[]

  @@index([status])
}

model AgentConfig {
  id             String        @id @default(cuid())
  name           String        @unique
  description    String?
  model          String        @default("claude-sonnet-4-6")
  systemPrompt   String        @default("")
  tools          String      @default("[]")
  environmentId  String?
  maxTokens      Int           @default(4096)
  temperature    Float         @default(0.7)
  status         String        @default("active") // active, deprecated
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  environment    Environment?          @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  versions       AgentConfigVersion[]

  @@index([status])
  @@index([environmentId])
}

model AgentConfigVersion {
  id             String       @id @default(cuid())
  agentConfigId  String
  version        Int
  snapshot       String
  changedBy      String       @default("system")
  changeReason   String?
  createdAt      DateTime     @default(now())

  agentConfig    AgentConfig  @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@index([agentConfigId])
  @@unique([agentConfigId, version])
}

model SpecChangeRequest {
  id           String    @id @default(cuid())
  specId       String
  level        String    // iron_law, guideline, tip
  changeTypes String @default("[]")
  summary      String
  status       String    @default("pending") // pending, approved, applied, rejected
  submittedBy  String
  submittedAt  DateTime  @default(now())
  appliedAt    DateTime?
  oldVersion   Int?
  newVersion   Int?
  metadata     String?

  @@index([specId])
  @@index([status])
  @@index([submittedBy])
  @@index([submittedAt])
}

model RoleMemoryEntry {
  id             String   @id @default(cuid())
  roleId         String
  type           String   // experience, decision, feedback, learning
  content        String
  taskId         String?
  importance     Int      @default(3) // 1-5
  scope          String   @default("project") // project | global
  embedding String @default("[]")  // 向量 embedding（pgvector 升级后改为 vector(1536)）
  metadata       String?
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outgoingRelations MemoryRelation[] @relation("FromMemory")
  incomingRelations MemoryRelation[] @relation("ToMemory")

  @@index([roleId])
  @@index([roleId, type])
  @@index([roleId, importance])
  @@index([roleId, scope])
  @@index([lastAccessedAt])
}

model MemoryRelation {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  relationType String   // caused_by, related_to, refines, contradicts
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())

  from         RoleMemoryEntry @relation("FromMemory", fields: [fromId], references: [id], onDelete: Cascade)
  to           RoleMemoryEntry @relation("ToMemory", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([fromId, relationType])
}

model MCPAuditLog {
  id         String   @id @default(cuid())
  toolName   String
  roleId     String?
  input      String?     // sanitized (no secrets)
  output     String?     // summary only
  duration   Int       // ms
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())

  @@index([toolName])
  @@index([roleId])
  @@index([createdAt])
}

model MCPPermission {
  id        String   @id @default(cuid())
  roleId    String
  toolName  String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, toolName])
  @@index([roleId])
}

model DecisionAudit {
  id          String   @id @default(cuid())
  eventType   String                       // meeting.completed / requirements.generated / goal.created / execution.completed / review.completed / wiki.updated / constraint.proposed / role.updated
  entityType  String                       // meeting / goal / execution / review / wiki / constraint / role
  entityId    String                       // ID of the primary entity
  companyId   String?
  projectId   String?
  summary     String                       // Human-readable one-liner
  details     String?                        // Full event payload
  actorRole   String?                      // Which role triggered this (analyst/executor/reviewer/knowledge_keeper/auditor/constraint_evolver)
  createdAt   DateTime  @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@index([companyId])
  @@index([createdAt])
}

model RoleConfig {
  id          String   @id @default(cuid())
  roleType    String   @unique
  companyId   String

  // ── 身份 ──
  systemPrompt String  @default("")

  // ── 立场（JSON，Analyst + Reviewer 共用） ──
  stances     String?

  // ── 推理档位 ──
  modelTier   String   @default("standard")
  modelRouting String?

  // ── 能力 ──
  boundSkills       String  @default("[]")
  boundMcps         String  @default("[]")
  boundTools        String  @default("[]")

  // ── 约束 ──
  boundConstraints  String  @default("[]")

  // ── 执行参数（Executor） ──
  executionParams   String?

  // ── 进化权限 ──
  evolutionHooks    String?

  // ── 元数据 ──
  version     Int      @default(1)
  updatedBy   String?
  updatedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([roleType, companyId])
}

// ─────────────────────────────────────────────
// Studio 2.0 新模型（2026-05-08）
// ─────────────────────────────────────────────

model Channel {
  id        String   @id @default(cuid())
  name      String   // "#研发" | "#决策" | "#系统"
  type      String   @default("rnd") // rnd | decision | system
  mode      String   @default("broadcast") // broadcast | conversation
  agentName String?  // conversation 模式绑定的 agent (analyst/reviewer/kk/...)
  sessionId String?  // Claude session-id (conversation 模式跨消息续接)
  defaultWorkspaceId String? // 默认执行 Workspace
  defaultPath        String? // 默认执行路径（相对于 workspaceRoot）
  discordChannelId String? // Discord 频道绑定
  discordWebhookUrl String? // Agent 回复推送目标
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ChannelMessage ChannelMessage[]
  RequirementsDoc RequirementsDoc[]

  @@unique([name])
}

model ChannelMessage {
  id        String   @id @default(cuid())
  channelId String
  authorType String  // "human" | "agent"
  agentName String?  // Analyst | Executor | Reviewer | KK | Auditor | Triage | Deploy
  content   String   // Markdown
  replyToId String?  // 弱引用回复关系
  meta      String   @default("{}") // JSON: { goalId?, requirementsDocId?, cardType?, cardData?, crossChannelRef?, atHuman? }
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([authorType])
}

model RequirementsDoc {
  id        String   @id @default(cuid())
  title     String
  content   String   // Markdown 全文
  acGroups  String?  // G34: JSON array of structured AC groups (source of truth)
  contractTests String? // TDD-07: JSON array of { file, content } — Analyst 契约测试
  contractTestsSkipReason String? // Analyst 主动跳过契约测试的原因
  tags      String   @default("[]") // JSON array
  goalId    String?  // 开始执行后关联
  projectId String?
  sourceChannelId String
  status    String   @default("draft") // draft | confirmed | done
  linkedDocIds String @default("[]") // JSON array of RequirementsDoc ids
  executionSummary String? // Goal 完成后补充
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channel   Channel  @relation(fields: [sourceChannelId], references: [id])

  @@index([status])
  @@index([goalId])
  @@index([sourceChannelId])
  @@index([projectId])
}

model Incident {
  id             String   @id
  type           String   // service_down | resource_critical | ext_dependency | zombie
  severity       String   // critical | warning
  status         String   @default("diagnosing") // diagnosing | fixing | resolved | escalated
  detectedAt     DateTime @default(now())
  resolvedAt     DateTime?
  resolution     String?
  triageLog      String   @default("[]") // JSON [{time, phase, action, result}]
  escalatedTo    String?
  pitfallCreated String?

  @@index([status])
  @@index([detectedAt])
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  type      String   // skill | pitfall | pattern | decision
  level     String   @default("skill") // agent_knowledge | skill | tool
  content   String   // 可复用的判断规则
  triggerCondition String? // 什么时候加载此知识
  sourceGoalId String
  projectId String?
  status    String   @default("active") // active | deprecated | under_review
  promotedAt  DateTime?
  downgradedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([sourceGoalId])
  @@index([level])
  @@index([projectId])
}

// ── 知识库五大缺口 (G-001~005, 2026-05-19) ──

model UserPreference {
  id          String   @id @default(cuid())
  userId      String   @default("default") // 当前单用户系统

  // 模型偏好
  preferredModel    String?  // premium | standard | fast
  modelUsageRatio   String   @default("{}") // {"premium":0.7,"standard":0.2,"fast":0.1}
  downgradeAccepted Boolean  @default(false)

  // 交互偏好
  responseStyle     String?  // concise | detailed | balanced
  messageFrequency  Float?   // 平均每小时消息数
  avgMessageLength  Int?
  preferredAgents   String   @default("[]") // ["@Analyst","@Executor"]

  // 决策偏好
  autoApproveThreshold  Float?  // 低于此置信度需人工确认
  reviewRoundsTolerance Int?

  // 工具偏好
  favoriteTools     String   @default("[]")
  toolRiskTolerance String?  // low | medium | high

  // 时间模式
  activeHours       String   @default("[]") // [9,10,11,14,15,16]
  avgSessionMinutes Int?

  // 工作流模式 (B9-025)
  workflowDistribution  String?  // JSON: {"ci_fix":5,"refactor":3,...}
  recurringWorkflows    String?  // JSON: [{type,count,successRate,lastSeen}]
  preferredWorkflowTypes String? // JSON: ["ci_fix","test_triage"]

  // 元数据
  confidence        Float    @default(0.3)
  lastInferredAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model BusinessRule {
  id          String   @id @default(cuid())

  name        String   // 唯一标识: min_requirement_length
  category    String   // constraint | architecture | behavior | threshold
  description String

  condition   String   // 触发条件
  action      String   // 执行动作
  defaultValue String? // 默认值

  source      String   // 来源文件: analst-trigger.service.ts:42
  sourceType  String   // code_constant | env_var | harness_constraint | config_file

  affects     String   @default("[]") // ["analyst","executor","reviewer"]

  status      String   @default("active") // active | modified | deprecated
  version     Int      @default(1)

  lastExtractedAt DateTime?
  lastVerifiedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, status])
  @@index([name])
}

model EnvironmentSnapshot {
  id          String   @id @default(cuid())

  // 系统层
  hostname    String
  platform    String
  nodeVersion String
  cpuCores    Int
  totalMemGB  Float

  // 服务层
  apiPort     Int
  webPort     Int
  nodeEnv     String
  dbPath      String

  // 部署层
  nginxConfig    String?
  serviceManager String?
  tunnelType     String?

  // 依赖层
  keyDependencies String  @default("{}") // {"harness":"0.13.0","prisma":"5.x"}

  // 已知限制
  knownLimitations String @default("[]") // [{"issue":"...","since":"..."}]

  takenAt     DateTime
  takenBy     String   @default("auto") // auto | manual
  diffFromPrev String? // 与上次快照的差异摘要

  createdAt   DateTime @default(now())

  @@index([takenAt])
}

model DecisionChain {
  id          String   @id @default(cuid())

  topic       String   // 决策主题
  category    String   // architecture | tooling | process | design

  context     String   // 决策背景
  options     String   // 候选方案 JSON
  chosen      String   // 选择的方案
  rationale   String   // 选择理由
  tradeoffs   String   // 已知权衡

  sourceType  String   // meeting | execution | pr | audit
  sourceId    String?  // 关联源 ID
  participants String  @default("[]")
  voteDistribution String?
  dissentNotes String?

  revisable   Boolean  @default(true)
  revisitCondition String?

  outcomeKnown    Boolean @default(false)
  outcomeSummary  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([sourceType])
  @@index([topic])
}

model InteractionPattern {
  id          String   @id @default(cuid())

  name        String   // 模式名称
  category    String   // tool_usage | workflow | error | collaboration
  description String

  pattern     String   // 模式定义 JSON
  frequency   Float    // 次/天
  confidence  Float    // 0-1

  insight     String   // 洞察
  suggestion  String?  // 优化建议

  observedPeriodStart DateTime
  observedPeriodEnd   DateTime

  status      String   @default("active") // active | outdated

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, status])
  @@index([confidence])
}

// ── 管线指标 (B1-016) ──

// ── 知识进化: Resolution Knowledge Base (2026-05-23) ──
// L3~L6 运维配置类知识 — 错误模式 → 已知解法映射

model Resolution {
  id          String   @id @default(cuid())
  pattern     String   // 错误匹配模式 (regex 或关键词子串)
  errorClass  String   // 对应 ErrorClass: permission_error | config_error | ...
  layer       String   @default("L5_error_fix") // L3_tool_behavior | L4_env_config | L5_error_fix | L6_causality
  title       String   // 人类可读标题
  fix         String   // 解法描述 (Markdown, 可直接注入 Agent prompt)
  status      String   @default("pending")    // pending | verified | canonical | deprecated
  verifyCount Int      @default(0)            // 验证次数 (>=3 → canonical)
  verifiedAt  DateTime?                       // 首次验证时间
  sourceGoalId String?                        // 首次发现的 Goal
  tags        String   @default("[]")         // JSON: ["cli","root","permission"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([errorClass])
  @@index([layer])
  @@index([status])
  @@index([verifyCount])
}

// ── 管线指标 (B1-016) ──

model PipelineRun {
  id        String   @id @default(cuid())
  source    String   // "pipeline" | "window"
  phase     String   // "analyst" | "executor" | "full"
  taskName  String
  model     String
  inputTokens     Int
  outputTokens    Int
  cacheHitTokens  Int      @default(0)
  durationMs      Int
  success         Boolean
  testPassed      Boolean?
  lintPassed      Boolean?
  diffLines       Int?
  error           String?
  sessionId       String?
  goalId          String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([phase])
  @@index([goalId])
}

// ── G30: Unified StudioEvent Table ──

model StudioEvent {
  id        String   @id @default(cuid())
  type      String
  source    String
  timestamp DateTime @default(now())
  payload   String

  // Pipeline execution metrics (observability)
  executionId    String?
  agentRole      String?
  modelTier      String?
  modelName      String?
  stage          String?
  sessionCount   Int?
  isContinued    Boolean?
  durationMs     Int?
  numTurns       Int?
  promptSize     Int?
  tokenInput     Int?
  tokenOutput    Int?
  tokenCacheRead Int?
  tokenCacheWrite Int?
  costUsd        Float?
  serviceTier    String?
  constraintHash String?
  constraintSize Int?
  precipitated   Boolean  @default(false) // G31: 知识沉淀标记，清理前必须为 true

  @@index([type])
  @@index([timestamp])
  @@index([executionId])
  @@index([agentRole])
}

// PipelineReview — 审查结果持久化 (OBS-2)
model PipelineReview {
  id             String   @id @default(cuid())
  executionId    String   @unique
  goalId         String?
  overallApproved Boolean  @default(false)
  score          Int?      // 0-100
  stanceCount    Int       @default(0)
  stancesJson    String    // JSON: 完整 stanceReports
  issuesJson     String    // JSON: 所有 issues
  summary        String?
  createdAt      DateTime  @default(now())

  @@index([goalId])
  @@index([createdAt])
  @@map("pipeline_review")
}

// PipelineDecision — 路由决策持久化 (OBS-6)
model PipelineDecision {
  id             String   @id @default(cuid())
  executionId    String   @unique
  goalId         String?
  tier           String    // fast/standard/premium
  reason         String    // classification reason
  acCount        Int       @default(0)
  fileCount      Int       @default(0)
  taskCategory   String?   // feature/bug/refactor/config/test
  riskHits       Int       @default(0)
  estimatedLines Int?
  featuresJson   String?   // JSON: full classification inputs
  createdAt      DateTime  @default(now())

  @@index([goalId])
  @@index([createdAt])
  @@map("pipeline_decision")
}

// KE-003: User behavior distillation profiles
model UserBehaviorProfile {
  id              String   @id @default(cuid())
  sessionId       String
  category        String   // correction | workflow | automation
  title           String
  evidence        String
  pattern         String
  suggestedAction String   // create_rule | create_skill | create_automation | skip
  confidence      Float
  alreadyCovered  String?
  status          String   @default("pending") // pending | confirmed | rejected | applied
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("user_behavior_profile")
}

// ── AS-020: Workspace + Daemon 算力接入 ──

model Workspace {
  id            String   @id @default(cuid())
  name          String
  tokenId       String?
  token         WorkspaceToken? @relation(fields: [tokenId], references: [id])
  workspaceRoot String
  hasDocker     Boolean  @default(false)
  os            String?
  arch          String?
  status        String   @default("offline")
  currentTask   String?
  lastHeartbeat DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runtimes      WorkspaceRuntime[]
  tasks         WorkspaceTask[]
  events        WorkspaceEvent[]
  repos         WorkspaceRepo[]
}

model WorkspaceRepo {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  path          String    // 相对于 workspaceRoot
  name          String    // 目录名
  category      String?   // 分类目录（如 backend/fe）
  description   String?   // 仓库描述
  defaultBranch String    @default("main")
  remoteUrl     String?   // git remote origin URL
  status        String    @default("active") // active | unavailable
  lastSyncedAt  DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]

  @@unique([workspaceId, path])
  @@index([workspaceId])
  @@index([remoteUrl])
  @@index([status])
}

model WorkspaceToken {
  id          String   @id @default(cuid())
  name        String
  tokenHash   String   @unique
  permissions String
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  workspaces  Workspace[]
}

model WorkspaceRuntime {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  name        String
  version     String?
  status      String   @default("online")
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  tasks       WorkspaceTask[]

  @@unique([workspaceId, provider])
}

model WorkspaceTask {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtimeId     String?
  runtime       WorkspaceRuntime? @relation(fields: [runtimeId], references: [id])
  parentGoalId  String?
  path          String
  prompt        String
  agent         String
  modelTier     String     @default("standard")
  sessionId     String?
  workDir       String?
  metadata      String?
  status        String     @default("pending")
  result        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
}

model WorkspaceEvent {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String?
  type        String
  content     String
  metadata    String?
  createdAt   DateTime   @default(now())
}

model FailureEvent {
  id           String   @id @default(cuid())
  executionId  String
  goalId       String
  category     String   // infra | pipeline | agent | unknown
  severity     String   // critical | warning
  errorMessage String
  routeTarget  String   // triage | resolution_kb | human
  incidentType String?  // TriageIncidentType if routed to triage
  matchedPattern String?
  createdAt    DateTime @default(now())

  @@unique([executionId, category])
  @@index([goalId])
}
