// ── AS-020: Workspace + Daemon 算力接入 ──

model Workspace {
  id            String   @id @default(cuid())
  name          String
  tokenId       String?
  token         WorkspaceToken? @relation(fields: [tokenId], references: [id])
  workspaceRoot String
  hasDocker     Boolean  @default(false)
  os            String?
  arch          String?
  status        String   @default("offline")
  currentTask   String?
  lastHeartbeat DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runtimes      WorkspaceRuntime[]
  tasks         WorkspaceTask[]
  events        WorkspaceEvent[]
  repos         WorkspaceRepo[]
}

model WorkspaceRepo {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  path          String    // 相对于 workspaceRoot
  name          String    // 目录名
  category      String?   // 分类目录（如 backend/fe）
  description   String?   // 仓库描述
  defaultBranch String    @default("main")
  remoteUrl     String?   // git remote origin URL
  status        String    @default("active") // active | unavailable
  lastSyncedAt  DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]

  @@unique([workspaceId, path])
  @@index([workspaceId])
  @@index([remoteUrl])
  @@index([status])
}

model WorkspaceToken {
  id          String   @id @default(cuid())
  name        String
  tokenHash   String   @unique
  permissions String
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  workspaces  Workspace[]
}

model WorkspaceRuntime {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String
  name        String
  version     String?
  status      String   @default("online")
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  tasks       WorkspaceTask[]

  @@unique([workspaceId, provider])
}

model WorkspaceTask {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtimeId     String?
  runtime       WorkspaceRuntime? @relation(fields: [runtimeId], references: [id])
  parentGoalId  String?
  path          String
  prompt        String
  agent         String
  modelTier     String     @default("standard")
  sessionId     String?
  workDir       String?
  metadata      String?
  status        String     @default("pending")
  result        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
}

model WorkspaceEvent {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String?
  type        String
  content     String
  metadata    String?
  createdAt   DateTime   @default(now())
}


