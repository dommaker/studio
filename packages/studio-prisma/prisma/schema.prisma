generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id           String         @id @default(cuid())
  name         String
  size         String         @default("small")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Documents    Document[]
  projects     Project[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   // null for OAuth users
  name         String?
  avatar       String?
  role           String    @default("Guest") // Guest, User, Admin
  emailVerified  DateTime? // 邮箱验证时间，null 表示未验证
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // 关联
  sessions                Session[]
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String?
  token     String    @unique // JWT
  guestId   String?   // Guest Session 的临时 ID
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  
  User      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OAuthAccount {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  providerAccountId String
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  profile          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([email])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([email])
}

model SpecReview {
  id                 String               @id @default(cuid())
  title              String
  description        String?
  changes            String
  changeType         String
  impact             String
  status             String               @default("pending")
  approvals          String
  requestedBy        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  reviewedAt         DateTime?
  reviewedBy         String?
  comment            String?
  SpecBypass         SpecBypass?
  SpecReviewApproval SpecReviewApproval[]
  SpecVersions       SpecVersion[]

  @@index([status])
  @@index([changeType])
  @@index([createdAt])
}

model SpecReviewApproval {
  id           String     @id @default(cuid())
  reviewId     String
  role         String
  reviewerId   String
  reviewerName String
  approved     Boolean
  comment      String?
  createdAt    DateTime   @default(now())
  SpecReview   SpecReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, role])
  @@index([reviewId])
  @@index([reviewerId])
}

model SpecBypass {
  id            String      @id @default(cuid())
  specReviewId  String?     @unique
  reason        String
  urgency       String
  requestedBy   String
  requestedName String?
  approvedBy    String?
  approvedName  String?
  status        String      @default("pending")
  reviewedAt    DateTime?
  completedAt   DateTime?
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  specReview    SpecReview? @relation(fields: [specReviewId], references: [id])

  @@index([status])
  @@index([requestedBy])
  @@index([approvedBy])
  @@index([createdAt])
}

model SpecVersion {
  id          String     @id @default(cuid())
  reviewId    String
  version     Int
  content     String
  diff        String?
  changeType  String
  changeDesc  String?
  createdBy   String
  createdName String?
  createdAt   DateTime   @default(now())
  review      SpecReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, version])
  @@index([reviewId])
  @@index([version])
  @@index([createdBy])
  @@index([createdAt])
}

model Project {
  id             String    @id @default(cuid())
  pmoNumber      String    @unique
  title          String
  description    String?
  requirement    String?
  companyId      String
  status         String    @default("pending")
  priority       String    @default("medium")
  gitBranch      String?
  gitRepo        String?
  workspaceRepoId String?
  workspaceRepo  WorkspaceRepo? @relation(fields: [workspaceRepoId], references: [id])
  progress       Int       @default(0)
  specFilePath   String?   // 🆕 FL-022: Spec 文档路径
  specVersion    Int?      @default(1)  // 🆕 FL-022: Spec 版本号
  requirementsDocId String?  // A4: bidirectional link to RequirementsDoc
  dependsOnPmoId  String?      // O3e: PMO number this project depends on
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Tasks          Task[]
  Documents      Document[] // 🆕 知识库文档关联
  Company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, pmoNumber])
  @@index([companyId])
  @@index([status])
  @@index([pmoNumber])
  @@map("project")
}

// 🆕 公司知识库文档
model Document {
  id              String    @id @default(cuid())
  projectId       String    // 关联 PMO 项目
  companyId       String    // 公司 ID
  
  // 文档属性
  type            String    // requirement/design/spec/execution/meeting/archive
  title           String
  content         String?   // 文档内容（Markdown）
  filePath        String?   // 文件路径（可选）
  
  // 元数据
  version         Int       @default(1)
  status          String    @default("active")  // active/archived/deleted
  tags String @default("[]")  // 标签
  
  // 作者信息
  createdBy       String?   // 创建者角色 ID
  updatedBy       String?   // 最后更新者
  
  // 时间
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?
  
  // 关联
  Project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, type, version])
  @@index([projectId])
  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([companyId, status, type])
  @@map("document")
}

model Task {
  id                 String     @id @default(cuid())
  projectId          String
  name               String
  description        String?
  assignee           String
  priority           String     @default("P2")
  status             String     @default("pending")
  claimedBy          String?
  claimedAt          DateTime?
  dependsOn String @default("[]")
  acceptanceCriteria String @default("[]")
  estimatedHours     Int?
  startedAt          DateTime?
  completedAt        DateTime?
  testEvidence       String?    // 🆕 AS-006: 测试证据路径
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  Project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assignee])
  @@index([priority])
  @@index([status])
  @@index([projectId])
  @@index([claimedBy])
  @@index([projectId, status])
}













