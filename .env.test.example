# 测试环境配置

NODE_ENV=development
LOG_LEVEL=debug

# 服务端口（固定端口，不易冲突）
PORT=13001
VITE_PORT=13000

# 数据库（测试，SQLite — B0-001 迁移）
DATABASE_URL="file:/root/projects/agent-studio/packages/studio-prisma/prisma/dev.db"

# EventBus（B0-002 迁移，替代 Redis）

# 已废弃：AGENT_RUNTIME_URL (runtime-proxy, sunset 2026-06-01), VITE_RUNTIME_API_URL

# 安全配置（测试可简化）
JWT_SECRET=test-jwt-secret
ENCRYPTION_KEY=test-encryption-key-32-chars

# 允许访问的目录（开发目录）
ALLOWED_DIRS=/root/knowledge-base,/root/projects

# WebSocket — B0-003 已迁 SSE

# 执行超时（测试可缩短）
DEFAULT_EXECUTION_TIMEOUT=600
MAX_EXECUTION_TIMEOUT=3600

# 开发工具
EXECUTION_MODE=queue
DEBUG_MODE=true