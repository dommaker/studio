# 线上环境配置

NODE_ENV=production
LOG_LEVEL=info

# 服务端口
PORT=3001

# 数据库（生产 — SQLite 单文件）
DATABASE_URL=file:/var/lib/agent-studio/data.db

# 已废弃配置（保留注释供参考）
# REDIS_URL — B0-002 已迁 EventBus/MemoryStore
# AGENT_RUNTIME_URL — runtime-proxy, sunset 2026-06-01
# VITE_RUNTIME_API_URL — 已废弃

# 安全配置（生产环境必须修改）
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production-32chars

# 允许访问的目录（生产环境）
ALLOWED_DIRS=/var/lib/agent-studio/projects,/var/lib/agent-studio/knowledge-base

# WebSocket — B0-003 已迁 SSE，以下配置已废弃
# WS_HEARTBEAT_INTERVAL=30000

# 执行超时
DEFAULT_EXECUTION_TIMEOUT=1800
MAX_EXECUTION_TIMEOUT=86400