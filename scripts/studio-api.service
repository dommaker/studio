[Unit]
Description=Studio API Server (Production)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/studio/apps/api

# 基础环境变量
Environment=NODE_ENV=production
Environment=PORT=13101
Environment=CLOUDFLARED_ENABLED=false
Environment=STUDIO_CONFIG_DIR=/root/.studio
Environment=DATABASE_URL=file:/root/.studio/data/data.db
Environment=no_proxy=localhost,127.0.0.1
Environment=REPO_DIR=/root/projects/studio
Environment=WORKTREES_DIR=/root/worktrees
Environment=IS_SANDBOX=1
Environment=PATH=/root/.nvm/versions/node/v22.22.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin

# 从统一配置文件加载 API keys（优先级低于上面的 Environment）
EnvironmentFile=-/root/.studio/config.env

ExecStopPre=/bin/bash -c 'curl -s http://localhost:13101/api/v1/health | grep -q "apiResponding" && echo "[studio-api] WARNING: daemon may have running tasks"' || true
TimeoutStopSec=90
ExecStart=/root/.nvm/versions/node/v22.22.0/bin/node --require /root/projects/studio/node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/preflight.cjs --import file:///root/projects/studio/node_modules/.pnpm/tsx@4.22.3/node_modules/tsx/dist/loader.mjs src/index.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=studio-api

[Install]
WantedBy=multi-user.target
