#!/bin/bash
# FL Flow CLI - 完整流程自动化工具 v2
# 
# 改进版：
# - 自动匹配角色类型
# - 批量完成任务
# - 更好的错误处理
#
# 用法：
#   fl-cli create-project "项目名称"
#   fl-cli create-task <projectId> "任务名称" [assignee]
#   fl-cli complete-all <projectId>              完成所有任务
#   fl-cli status <projectId>
#   fl-cli test-flow "项目名称"                  完整流程测试

set -e

BASE_URL="${FL_API_URL:-http://localhost:13101/api/v1}"
COMPANY_ID="${FL_COMPANY_ID:-cmo77h9qf0002vsqjikl1qul9}"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

help() {
  echo "FL Flow CLI v2 - 完整流程自动化工具"
  echo ""
  echo "用法:"
  echo "  fl-cli create-project <title>              创建项目"
  echo "  fl-cli create-task <projectId> <name> [a]  创建任务"
  echo "  fl-cli claim <taskId>                      领取任务"
  echo "  fl-cli start <taskId>                      开始任务"
  echo "  fl-cli complete <taskId>                   完成任务"
  echo "  fl-cli complete-all <projectId>            完成所有任务"
  echo "  fl-cli status <projectId>                  查看状态"
  echo "  fl-cli list-tasks <projectId>              列出任务"
  echo "  fl-cli list-roles                          列出角色"
  echo ""
  echo "会议相关:"
  echo "  fl-cli create-meeting [projectId] <title>  创建会议"
  echo "  fl-cli end-meeting <meetingId>             结束会议"
  echo "  fl-cli assign-tasks <meetingId>            分配任务"
  echo "  fl-cli meeting-status <meetingId>          会议状态"
  echo "  fl-cli list-meetings                       会议列表"
  echo ""
  echo "完整测试:"
  echo "  fl-cli test-flow <title>                   完整流程测试"
  echo "  fl-cli test-meeting <title>                会议流程测试"
  echo ""
  echo "环境变量:"
  echo "  FL_API_URL      API 地址（默认: http://localhost:13101/api/v1）"
  echo "  FL_COMPANY_ID   公司 ID（默认: cmo77h9qf0002vsqjikl1qul9）"
  echo ""
}

# 根据类型获取匹配的角色
get_role_by_type() {
  local type="$1"
  
  # 从角色列表中查找匹配类型
  ROLES=$(curl -s "$BASE_URL/roles?companyId=$COMPANY_ID")
  
  # 尝试匹配类型
  ROLE_ID=$(echo "$ROLES" | jq -r --arg type "$type" '.data[] | select(.type == $type) | .id' | head -1)
  
  # 如果没找到，返回第一个角色
  if [ -z "$ROLE_ID" ] || [ "$ROLE_ID" = "null" ]; then
    ROLE_ID=$(echo "$ROLES" | jq -r '.data[0].id')
  fi
  
  echo "$ROLE_ID"
}

# 获取角色类型
get_role_type() {
  local roleId="$1"
  curl -s "$BASE_URL/roles/$roleId" | jq -r '.type'
}

# 列出角色
list_roles() {
  echo -e "${BLUE}角色列表${NC}"
  curl -s "$BASE_URL/roles?companyId=$COMPANY_ID" | jq '.data[] | {id, name, type}'
}

# === 会议相关功能 ===

create_meeting() {
  local projectId="$1"
  local title="$2"
  
  if [ -z "$title" ]; then
    title="$projectId"
    projectId=""
  fi
  
  echo -e "${BLUE}创建 Meeting...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/meetings" \
    -H "Content-Type: application/json" \
    -d '{"title":"'$title'","companyId":"'$COMPANY_ID'","projectId":"'$projectId'","mode":"sync","maxRounds":3}')
  
  ID=$(echo "$RESULT" | jq -r '.data.id')
  
  if [ -z "$ID" ] || [ "$ID" = "null" ]; then
    echo -e "${RED}❌ 创建失败${NC}"
    echo "$RESULT" | jq '.error' 2>/dev/null || echo "$RESULT"
    return 1
  fi
  
  echo -e "${GREEN}✅ Meeting 创建成功${NC}"
  echo -e "${CYAN}ID:${NC}    $ID"
  echo -e "${CYAN}Title:${NC} $title"
  echo ""
  echo "$ID"
}

end_meeting() {
  local meetingId="$1"
  
  echo -e "${BLUE}结束 Meeting...${NC}"
  RESULT=$(curl -s -X PUT "$BASE_URL/meetings/$meetingId" \
    -H "Content-Type: application/json" \
    -d '{"status":"completed"}')
  
  STATUS=$(echo "$RESULT" | jq -r '.status')
  
  echo -e "${GREEN}✅ Meeting 已结束${NC}"
  echo -e "${CYAN}Status:${NC} $STATUS"
}

assign_tasks() {
  local meetingId="$1"
  
  echo -e "${BLUE}分配任务...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/meetings/$meetingId/assign-tasks")
  
  echo "$RESULT" | jq '.'
}

meeting_status() {
  local meetingId="$1"
  
  echo -e "${BLUE}Meeting 状态${NC}"
  curl -s "$BASE_URL/meetings/$meetingId" | jq '.data | {id, title, status, decisions}'
}

list_meetings() {
  local limit="${1:-10}"
  
  echo -e "${BLUE}会议列表${NC}"
  curl -s "$BASE_URL/meetings?limit=$limit" | jq '.data[] | {id: .id[:8], title, status}'
}

test_meeting() {
  local title="$1"
  
  echo -e "${YELLOW}=== 会议流程测试 ===${NC}"
  echo ""
  
  # 1. 创建 Project
  echo -e "${BLUE}1. 创建 Project...${NC}"
  PROJECT_ID=$(create_project "$title")
  
  # 2. 创建 Meeting
  echo ""
  echo -e "${BLUE}2. 创建 Meeting...${NC}"
  MEETING_ID=$(create_meeting "$PROJECT_ID" "评审: $title")
  
  # 3. 手动添加决策
  echo ""
  echo -e "${BLUE}3. 添加决策（模拟讨论）...${NC}"
  curl -s -X PUT "$BASE_URL/meetings/$MEETING_ID" \
    -H "Content-Type: application/json" \
    -d '{"decisions":[{"content":"采用方案A","agreed":true,"roles":["developer"],"priority":"P0"}]}' > /dev/null
  echo -e "${GREEN}✅ 决策已添加${NC}"
  
  # 4. 结束会议
  echo ""
  end_meeting "$MEETING_ID"
  
  # 5. 分配任务
  echo ""
  assign_tasks "$MEETING_ID"
  
  # 6. 查看状态
  echo ""
  echo -e "${BLUE}会议状态${NC}"
  meeting_status "$MEETING_ID"
  
  echo ""
  echo -e "${GREEN}=== 测试完成 ===${NC}"
}

create_project() {
  local title="$1"
  local desc="${2:-}"
  
  echo -e "${BLUE}创建 Project...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/pmo/project" \
    -H "Content-Type: application/json" \
    -d '{"companyId":"'$COMPANY_ID'","title":"'$title'","description":"'$desc'"}')
  
  ID=$(echo "$RESULT" | jq -r '.id')
  PMO=$(echo "$RESULT" | jq -r '.pmoNumber')
  
  if [ -z "$ID" ] || [ "$ID" = "null" ]; then
    echo -e "${RED}❌ 创建失败${NC}"
    echo "$RESULT" | jq '.error.message' 2>/dev/null || echo "$RESULT"
    return 1
  fi
  
  echo -e "${GREEN}✅ Project 创建成功${NC}"
  echo -e "${CYAN}PMO:${NC} $PMO"
  echo -e "${CYAN}ID:${NC}  $ID"
  echo ""
  echo "$ID"
}

create_task() {
  local projectId="$1"
  local name="$2"
  local assignee="${3:-developer}"
  local priority="${4:-P1}"
  
  echo -e "${BLUE}创建 Task ($assignee)...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/tasks" \
    -H "Content-Type: application/json" \
    -d '{"projectId":"'$projectId'","name":"'$name'","assignee":"'$assignee'","priority":"'$priority'"}')
  
  ID=$(echo "$RESULT" | jq -r '.id')
  
  if [ -z "$ID" ] || [ "$ID" = "null" ]; then
    echo -e "${RED}❌ 创建失败${NC}"
    echo "$RESULT" | jq '.error' 2>/dev/null || echo "$RESULT"
    return 1
  fi
  
  echo -e "${GREEN}✅ Task 创建成功${NC}"
  echo -e "${CYAN}ID:${NC}       $ID"
  echo -e "${CYAN}Name:${NC}     $name"
  echo -e "${CYAN}Assignee:${NC} $assignee"
  echo ""
  echo "$ID"
}

claim_task() {
  local taskId="$1"
  local assigneeType="${2:-}"
  
  # 获取任务 assignee
  if [ -z "$assigneeType" ]; then
    assigneeType=$(curl -s "$BASE_URL/tasks/$taskId" | jq -r '.assignee')
  fi
  
  # 获取匹配的角色
  roleId=$(get_role_by_type "$assigneeType")
  
  echo -e "${BLUE}领取 Task ($assigneeType → role: $roleId)...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/tasks/$taskId/claim" \
    -H "Content-Type: application/json" \
    -d '{"roleId":"'$roleId'"}')
  
  STATUS=$(echo "$RESULT" | jq -r '.status')
  
  if [ "$STATUS" = "null" ]; then
    echo -e "${RED}❌ 领取失败${NC}"
    echo "$RESULT" | jq '.error' 2>/dev/null || echo "$RESULT"
    return 1
  fi
  
  echo -e "${GREEN}✅ Task 已领取${NC}"
  echo -e "${CYAN}Status:${NC} $STATUS"
}

start_task() {
  local taskId="$1"
  
  echo -e "${BLUE}开始 Task...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/tasks/$taskId/start")
  
  STATUS=$(echo "$RESULT" | jq -r '.status')
  
  echo -e "${GREEN}✅ Task 开始执行${NC}"
  echo -e "${CYAN}Status:${NC} $STATUS"
}

complete_task() {
  local taskId="$1"
  
  echo -e "${BLUE}完成 Task...${NC}"
  RESULT=$(curl -s -X POST "$BASE_URL/tasks/$taskId/complete" \
    -H "Content-Type: application/json" \
    -d '{}')
  
  STATUS=$(echo "$RESULT" | jq -r '.status')
  ALL_DONE=$(echo "$RESULT" | jq -r '.allTasksCompleted')
  PR=$(echo "$RESULT" | jq -r '.prCreated')
  
  echo -e "${GREEN}✅ Task 完成${NC}"
  echo -e "${CYAN}Status:${NC}       $STATUS"
  echo -e "${CYAN}AllDone:${NC}     $ALL_DONE"
  echo -e "${CYAN}PR:${NC}         $PR"
  
  if [ "$ALL_DONE" = "true" ]; then
    echo -e "${YELLOW}🎉 所有任务完成！Project 已进入 in_review${NC}"
  fi
}

complete_all() {
  local projectId="$1"
  
  echo -e "${YELLOW}=== 完成所有任务 ===${NC}"
  
  # 获取所有 pending/claimed 任务
  TASKS=$(curl -s "$BASE_URL/tasks?projectId=$projectId" | jq -r '.[] | select(.status != "completed") | .id')
  
  if [ -z "$TASKS" ]; then
    echo -e "${GREEN}所有任务已完成${NC}"
    return 0
  fi
  
  for TASK in $TASKS; do
    echo ""
    ASSIGN=$(curl -s "$BASE_URL/tasks/$TASK" | jq -r '.assignee')
    echo -e "${CYAN}处理: $TASK ($ASSIGN)${NC}"
    
    claim_task "$TASK" "$ASSIGN"
    start_task "$TASK"
    complete_task "$TASK"
  done
  
  echo ""
  echo -e "${YELLOW}=== 最终状态 ===${NC}"
  status "$projectId"
}

status() {
  local projectId="$1"
  
  echo -e "${BLUE}Project 状态${NC}"
  PROJECT=$(curl -s "$BASE_URL/pmo/project/$projectId")
  echo "$PROJECT" | jq '{pmoNumber, status, gitBranch, progress}'
  
  echo ""
  echo -e "${BLUE}Tasks 状态${NC}"
  curl -s "$BASE_URL/tasks?projectId=$projectId" | jq '.[] | {name, assignee, status}'
  
  # 统计
  TOTAL=$(curl -s "$BASE_URL/tasks?projectId=$projectId" | jq '. | length')
  DONE=$(curl -s "$BASE_URL/tasks?projectId=$projectId" | jq '[.[] | select(.status == "completed")] | length')
  
  echo ""
  echo -e "${CYAN}完成进度: $DONE/$TOTAL${NC}"
}

list_tasks() {
  local projectId="$1"
  
  echo -e "${BLUE}任务列表${NC}"
  curl -s "$BASE_URL/tasks?projectId=$projectId" | jq '.[] | {id: .id[:8], name, assignee, priority, status}'
}

test_flow() {
  local title="$1"
  
  echo -e "${YELLOW}=== FL 完整流程自动化测试 ===${NC}"
  echo ""
  
  # 1. 创建 Project
  PROJECT_ID=$(create_project "$title")
  
  # 2. 设置 gitBranch
  echo ""
  echo -e "${BLUE}设置 gitBranch...${NC}"
  PMO=$(curl -s "$BASE_URL/pmo/project/$PROJECT_ID" | jq -r '.pmoNumber')
  curl -s -X PUT "$BASE_URL/pmo/project/$PROJECT_ID" \
    -H "Content-Type: application/json" \
    -d '{"gitBranch":"feature/'$PMO'-test","status":"active"}' > /dev/null
  echo -e "${GREEN}✅ gitBranch: feature/$PMO-test${NC}"
  
  # 3. 创建 Tasks
  echo ""
  TASK1=$(create_task "$PROJECT_ID" "设计方案" "architect" "P0")
  TASK2=$(create_task "$PROJECT_ID" "实现功能" "developer" "P1")
  TASK3=$(create_task "$PROJECT_ID" "代码审查" "reviewer" "P2")
  
  # 4. 完成所有任务
  echo ""
  complete_all "$PROJECT_ID"
  
  echo ""
  echo -e "${GREEN}=== 测试完成 ===${NC}"
}

# 主命令
case "$1" in
  create-project)
    create_project "$2" "$3"
    ;;
  create-task)
    create_task "$2" "$3" "$4" "$5"
    ;;
  claim)
    claim_task "$2" "$3"
    ;;
  start)
    start_task "$2"
    ;;
  complete)
    complete_task "$2"
    ;;
  complete-all)
    complete_all "$2"
    ;;
  status)
    status "$2"
    ;;
  list-tasks)
    list_tasks "$2"
    ;;
  list-roles)
    list_roles
    ;;
  create-meeting)
    create_meeting "$2" "$3"
    ;;
  end-meeting)
    end_meeting "$2"
    ;;
  assign-tasks)
    assign_tasks "$2"
    ;;
  meeting-status)
    meeting_status "$2"
    ;;
  list-meetings)
    list_meetings "$2"
    ;;
  test-flow)
    test_flow "$2"
    ;;
  test-meeting)
    test_meeting "$2"
    ;;
  help|--help|-h)
    help
    ;;
  *)
    help
    ;;
esac