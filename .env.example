# 环境配置模板

PORT=3001
VITE_PORT=5173

JWT_SECRET=your-jwt-secret-change-this
ENCRYPTION_KEY=your-encryption-key-32-chars-minimum

DEFAULT_EXECUTION_TIMEOUT=1800
MAX_EXECUTION_TIMEOUT=86400

ALLOWED_DIRS=~/projects,~/knowledge-base
DEBUG_MODE=false

# 公网 HTTPS 隧道（仅服务器部署需要，本地开发忽略）
# CLOUDFLARED_ENABLED=false
# CLOUDFLARED_TUNNEL_MODE=quick

# 数据目录（运行时数据，默认 ~/.studio/）
# STUDIO_DATA_DIR=~/.studio
# WORKTREES_DIR=~/.studio/worktrees
# EVENTS_DIR=~/.studio/events
# KNOWLEDGE_DIR=~/.studio/knowledge
# ANALYST_DIR=~/.studio/.analyst

# 项目根目录（代码所在，自动检测 package.json）
# REPO_DIR=~/projects/studio

# 审查超时（分钟）
# REVIEW_TIMEOUT_MINUTES=15

# 知识库路径（冷启动导入用）
# KNOWLEDGE_BASE_PATH=~/knowledge-base
