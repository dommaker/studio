# Agent Studio 环境配置模板

# ==================== 必需配置 ====================

# 数据库（SQLite 单文件）
DATABASE_URL="file:./data.db"

# 服务端口
PORT=3001
VITE_PORT=5173

# ==================== 已废弃配置 ====================
# AGENT_RUNTIME_URL — runtime-proxy (sunset 2026-06-01)
# REDIS_URL — 已迁 EventBus/MemoryStore (B0-002)
# WS_HEARTBEAT_INTERVAL — 已迁 SSE (B0-003)

# ==================== 可选配置 ====================

# 执行超时
DEFAULT_EXECUTION_TIMEOUT=1800
MAX_EXECUTION_TIMEOUT=86400

# ==================== 安全配置 ====================

# JWT Secret（生产环境必须修改）
JWT_SECRET=your-jwt-secret-change-this

# Encryption Key（生产环境必须修改）
ENCRYPTION_KEY=your-encryption-key-32-chars-minimum

# ==================== 文件访问 ====================

# 允许访问的目录（逗号分隔）
ALLOWED_DIRS=/root/knowledge-base,/root/projects

# ==================== 开发工具 ====================

# 调试模式
DEBUG_MODE=false

# Token 追踪显示
SHOW_TOKEN_USAGE=true
