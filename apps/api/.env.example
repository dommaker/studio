# Optional: Direct connection for migrations
DIRECT_URL="postgresql://user:password@localhost:5432/agent_studio"

# 开放注册开关：缺省关闭（单租户自托管口径），显式设 "true" 才开放 /api/v1/auth/register
# REGISTER_ENABLED="true"

# CORS 白名单（逗号分隔）：缺省主站两域 + localhost 开发源 + 临时隧道域名
# CORS_ORIGINS="https://dommaker.cn,https://www.dommaker.cn"

# PMO gitRepo 允许根（冒号分隔）：缺省 /root/projects
# PMO_GIT_REPO_ROOTS="/root/projects"
